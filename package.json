{
  "name": "chess-desktop",
  "productName": "Chess.com",
  "version": "1.0.0",
  "description": "Unofficial Chess.com desktop app (Electron) for macOS, Windows and Debian Linux.",
  "main": "src/main.js",
  "author": "SoftDirect <corp@softdirect.hu>",
  "license": "MIT",
  "homepage": "https://github.com/hariel1985/ChessDesktop",
  "repository": "github:hariel1985/ChessDesktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist": "electron-builder -mwl"
  },
  "build": {
    "appId": "hu.softdirect.chessdesktop",
    "productName": "Chess.com",
    "artifactName": "Chess.com-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.board-games",
      "icon": "build/icon-mac.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "build/icons",
      "category": "Game",
      "synopsis": "Chess.com desktop app",
      "maintainer": "SoftDirect <corp@softdirect.hu>",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "chess-com"
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libsecret-tools"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.33.5"
  }
}
